{
  "name": "intuitui-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://jydny.github.io/intuitui-portfolio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "encrypt": "staticrypt dist/index.html -d dist --remember false --short --template-title \"intuitui\" --template-instructions \"Enter the password to view this portfolio.\"",
    "predeploy": "npm run build && npm run encrypt",
    "deploy": "gh-pages -d dist -t -f --nojekyll"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "react-router-dom": "^7.18.2",
    "staticrypt": "^3.5.4",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
